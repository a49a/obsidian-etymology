{
	"name": "etymology-fetch",
	"version": "1.1.0",
	"description": "Obsidian plugin: look up word etymologies, generate AI vocabulary notes, organize them by semantic groups, and export Anki cards.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"dev:dist": "node scripts/dev-dist.mjs",
		"build": "npm run build:plugin && npm run package:release",
		"deploy": "npm run build && node scripts/deploy-to-vault.mjs",
		"build:plugin": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"package:release": "node scripts/package-release.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^22.20.4",
		"esbuild": "^0.28.2",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
